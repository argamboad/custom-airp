{
  "OurDream": {
    "ProfileDirectory": "./profile",
    "Headless": true,
    "Theme": "Dark",
    "AutoRefreshSeconds": 60,
    "ShowLineNumbers": true,
    "Keyboard": "Standard",
    "MouseSupport": false,
    "Profile": "default",
    "ExportDirectory": "./exports",
    "OfflineCache": true,
    "PromptHistoryDepth": 25,
    "RestoreSession": true,
    "Site": {
      "BaseUrl": "https://ourdream.ai",
      "ChatsPath": "/chat",
      "ChatPath": "/chat/{id}",
      "HistoryPath": "/generate",
      "SignInPath": "/login",
      "NavigationTimeoutSeconds": 30,
      "GenerationTimeoutSeconds": 600,
      "SignInTimeoutMinutes": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  }
}

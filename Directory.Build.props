<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>Airp contributors</Authors>
    <Product>Airp</Product>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The version is the nearest v* tag, read at build time. It used to be a literal here,
    which meant the number the binary reported and the tag the release workflow was built
    from were two separate things that nobody kept in step: a release cut from v1.2.0 would
    still have said 1.0.0 of itself.

    The useful consequence is local: a build off the tagged commit is 1.0.0, and one three
    commits later is 1.0.1-alpha.0.3 with the commit on the end. So a tool installed from
    a working tree says so, rather than passing for the release.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Public API surface of the library projects is documented with XML comments.
    The terminal front-end keeps most types internal, so documentation generation
    is only switched on where there is a real public contract to describe.
  -->
  <PropertyGroup Condition="'$(IsLibraryProject)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
